# Node.js 22.13+ required. Keep the SQLite file on a persistent disk.
DATABASE_PATH=./data/ditto.sqlite
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
MODEL_BASE_URL=https://api.meta.ai/v1
SERPAPI_API_KEY=
# Enable only behind HTTPS; localhost development uses false.
COOKIE_SECURE=false

# Public deployment: explicit HTTPS origin; auto-detected from Railway domain if omitted.
PUBLIC_ORIGIN=
# Docker deployment enforces /data volume, secure cookies, and valid HTTPS origin.
# Set true in hosting; not needed for npm run dev.
REQUIRE_PERSISTENT_VOLUME=false

# Keep false until live testing is explicitly authorized. Both providers are guarded.
ALLOW_LIVE_PROVIDERS=false

# Public /demo live requests share normal provider credentials, with hard persisted caps.
# Set false to pause external calls for demo visitors without affecting real users.
PUBLIC_DEMO_LIVE=true
